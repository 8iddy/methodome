{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "methodome-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "methodome.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "NEXT_PUBLIC_METHODOME_API_URL": "https://api.methodome.com/api"
  },
  "observability": {
    "enabled": true
  }
}
