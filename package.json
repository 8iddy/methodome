{
  "name": "methodome",
  "private": true,
  "version": "0.0.0",
  "description": "Research analysis platform",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:check": "prettier --check .",
    "dev:api": "wrangler dev --config wrangler.jsonc",
    "deploy:api": "wrangler deploy --config wrangler.jsonc",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "web:typecheck": "npm --workspace @methodome/web run typecheck",
    "web:build": "npm --workspace @methodome/web run build",
    "check:integration": "npm run typecheck && npm test && npm run d1:migrate:local && npx wrangler deploy --dry-run --config wrangler.jsonc && npm run web:typecheck && npm run web:build",
    "deploy:production": "bash scripts/deploy-production.sh",
    "smoke:production": "METHODOME_API_URL=https://api.methodome.com/api node scripts/e2e-smoke.mjs",
    "smoke:conversation": "METHODOME_API_URL=https://api.methodome.com/api node scripts/e2e-conversation.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.2",
    "@cloudflare/workers-types": "5.20260928.1",
    "wrangler": "4.141.0"
  },
  "dependencies": {
    "zod": "^3.24.1",
    "hono": "^4.9.8",
    "better-auth": "1.7.6"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
