{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "methodome-api",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "development",
    "AUTH_MODE": "disabled",
    "ALLOWED_ORIGINS": "https://methodome.com,http://localhost:3000",
    "MAX_DIRECT_UPLOAD_BYTES": "26214400"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "methodome",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ANALYSIS_QUEUE",
        "queue": "methodome-analysis"
      }
    ]
  }
}
