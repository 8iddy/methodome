{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "methodome-api",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "production",
    "AUTH_MODE": "better_auth",
    "ALLOWED_ORIGINS": "https://methodome.com,http://localhost:3000",
    "MAX_DIRECT_UPLOAD_BYTES": "26214400",
    "STORAGE_MODE": "r2",
    "BETTER_AUTH_URL": "https://api.methodome.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "methodome",
      "database_id": "2a7e2a38-14fb-4fca-882b-8bac86d44536",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ANALYSIS_QUEUE",
        "queue": "methodome-analysis"
      }
    ],
    "consumers": [
      {
        "queue": "methodome-analysis",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "methodome-files"
    }
  ],
  "services": [
    {
      "binding": "STATS",
      "service": "methodome-stats"
    }
  ],
  "routes": [
    {
      "pattern": "api.methodome.com",
      "custom_domain": true
    }
  ]
}
