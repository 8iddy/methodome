{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "methodome-api",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "development",
    "AUTH_MODE": "disabled",
    "ALLOWED_ORIGINS": "https://methodome.com,http://localhost:3000",
    "MAX_DIRECT_UPLOAD_BYTES": "26214400",
    "STORAGE_MODE": "disabled",
    "BETTER_AUTH_URL": "https://methodome-api.abakogideon.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "methodome",
      "database_id": "2a7e2a38-14fb-4fca-882b-8bac86d44536",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ANALYSIS_QUEUE",
        "queue": "methodome-analysis"
      }
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
